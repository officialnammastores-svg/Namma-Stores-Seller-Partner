# ==============================================================================
# NAMMA STORES SELLER PARTNER — ENVIRONMENT CONFIGURATION
# Project: namma-stores-seller-partner (Whitefield, Bengaluru)
# ==============================================================================

# Server Port (AI Studio preview environment requires 3000)
PORT=3000

# App URL (automatically provided by Cloud Run or host)
APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 1. SUPABASE PROJECT (Server-Side Persistence — Never expose service role key)
# ------------------------------------------------------------------------------
SUPABASE_URL="https://your-namma-stores-seller-partner-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-server-side-service-role-key"

# ------------------------------------------------------------------------------
# 2. RESEND TRANSACTIONAL EMAIL (Server-Side Only — Never expose in frontend!)
# Both RESEND_API_KEY and RESEND_FROM_EMAIL are required.
# RESEND_FROM_EMAIL must use a domain verified in your Resend account
# (e.g., Namma Stores <applications@nammastores.com>).
# Internal seller application notifications are sent exclusively to
# official.nammastores@gmail.com (set OWNER_NOTIFICATION_EMAIL="disabled"
# on the server only if internal email alerts should be turned off).
# ------------------------------------------------------------------------------
RESEND_API_KEY="re_your_resend_api_key_here"
RESEND_FROM_EMAIL="Namma Stores <applications@nammastores.com>"
RESEND_REPLY_TO_EMAIL="official.nammastores@gmail.com"
OWNER_NOTIFICATION_EMAIL="official.nammastores@gmail.com"

# ------------------------------------------------------------------------------
# 3. MARKETING, SOCIAL & COMMUNITY LINKS (Optional Client Overrides)
# ------------------------------------------------------------------------------
VITE_WHATSAPP_SELLER_COMMUNITY_URL="https://chat.whatsapp.com/REPLACE_WITH_OFFICIAL_SELLER_COMMUNITY_INVITE"
VITE_INSTAGRAM_URL="https://www.instagram.com/namma.stores/"
VITE_META_PIXEL_ID="3507843232726532"
VITE_ENABLE_ANALYTICS="true"
